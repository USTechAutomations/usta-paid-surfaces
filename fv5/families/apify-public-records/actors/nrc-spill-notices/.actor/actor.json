{
  "actorSpecification": 1,
  "name": "nrc-spill-notices",
  "title": "NRC Spill Notices Scraper",
  "description": "Filter the NRC 2026 initial spill-report workbook by state, incident date and material. Export one item per report with quantities, units and source provenance. Initial reports are unvalidated; no caller details.",
  "version": "0.3",
  "buildTag": "nrc-recovery-20260912",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "NRC spill notices",
      "views": {
        "overview": {
          "title": "Incidents",
          "transformation": {
            "fields": [
              "report_id",
              "incident_date",
              "date_status",
              "state",
              "city",
              "material",
              "quantity",
              "quantity_unit",
              "medium",
              "incident_type",
              "report_status",
              "source_url",
              "materials"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
