{
  "actorSpecification": 1,
  "name": "osha-severe-injury-reports",
  "title": "OSHA Severe-Injury Reports Scraper",
  "description": "Filter OSHA severe-injury records by state, date, industry and employer. Uses a validated source copy checked daily; stale collections are refused. Includes source dates and injury counts, with no worker names or addresses.",
  "version": "0.3",
  "buildTag": "osha-recovery-20260912",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "OSHA severe-injury reports",
      "views": {
        "overview": {
          "title": "Reports",
          "transformation": {
            "fields": [
              "report_key",
              "id",
              "event_date",
              "employer",
              "city",
              "state",
              "naics",
              "hospitalized",
              "amputation",
              "loss_of_eye",
              "nature",
              "body_part",
              "source_period_to",
              "source_url"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  }
}
